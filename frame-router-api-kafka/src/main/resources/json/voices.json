{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoiceNotification",
  "type": "object",
  "required": [
    "logicalInfo",
    "action",
    "serverInfo"
  ],
  "properties": {
    "logicalInfo": {
      "title": "LogicalInfo",
      "type": "object",
      "required": [
        "communityId",
        "voiceId",
        "userId"
      ],
      "properties": {
        "communityId": {
          "type": "integer"
        },
        "voiceId": {
          "type": "integer"
        },
        "targetId": {
          "type": "integer"
        },
        "listenerIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "action": {
      "type": "string",
      "enum": [
        "JOINED",
        "LEFT"
      ]
    },
    "serverInfo": {
      "title": "ServerInfo",
      "type": "object",
      "required": [
        "channelId",
        "shadowId"
      ],
      "properties": {
        "channelId": {
          "type": "integer"
        },
        "shadowId": {
          "javaType": "java.lang.Integer",
          "type": "integer"
        }
      }
    }
  }
}