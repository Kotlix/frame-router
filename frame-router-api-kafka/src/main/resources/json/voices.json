{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoiceNotification",
  "type": "object",
  "required": [
    "connectionInfo",
    "voiceInfo",
    "serverInfo"
  ],
  "properties": {
    "connectionInfo": {
      "title": "ConnectionInfo",
      "type": "object",
      "required": [
        "voiceRegion",
        "voiceName",
        "channelId"
      ],
      "properties": {
        "voiceRegion": {
          "type": "string"
        },
        "voiceName": {
          "type": "string"
        },
        "channelId": {
          "type": "integer"
        }
      }
    },
    "voiceInfo": {
      "title": "VoiceInfo",
      "type": "object",
      "required": [
        "party",
        "communityId",
        "voiceId"
      ],
      "properties": {
        "party": {
          "type": "array",
          "items": {
            "$ref": "attendant.json"
          }
        },
        "communityId": {
          "type": "integer"
        },
        "voiceId": {
          "type": "integer"
        }
      }
    },
    "updateInfo": {
      "title": "UpdateInfo",
      "type": "object",
      "required": [
        "action",
        "attendant"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "JOINED",
            "LEFT"
          ]
        },
        "attendant": {
          "$ref": "attendant.json"
        }
      }
    }
  }
}