{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoiceNotification",
  "type": "object",
  "required": [
    "party",
    "action",
    "serverInfo"
  ],
  "properties": {
    "connectionInfo": {
      "title": "ConnectionInfo",
      "type": "object",
      "required": [
        "voiceRegion",
        "voiceName",
        "channelId"
      ],
      "properties": {
        "voiceRegion": {
          "type": "string"
        },
        "voiceName": {
          "type": "string"
        },
        "channelId": {
          "type": "integer"
        }
      }
    },
    "party": {
      "type": "array",
      "items": {
        "$ref": "attendant.json"
      }
    },
    "updateInfo": {
      "title": "UpdateInfo",
      "type": "object",
      "required": [
        "voiceRegion",
        "voiceName",
        "channelId"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "JOINED",
            "LEFT"
          ]
        },
        "attendant": {
          "$ref": "attendant.json"
        }
      }
    }
  }
}